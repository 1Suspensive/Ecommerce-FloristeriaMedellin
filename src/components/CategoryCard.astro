---
import type { Category } from "../lib/catalog";

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<a
  href={`/${category.slug}`}
  class="group relative flex h-full flex-col rounded-xl border border-beige/50 bg-white shadow-sm transition duration-300 ease-out hover:z-20 hover:scale-[1.04] hover:shadow-xl focus-visible:z-20 focus-visible:scale-[1.04] focus-visible:shadow-xl motion-reduce:transform-none motion-reduce:transition-none"
>
  <div class="relative overflow-hidden rounded-t-xl">
    <img
      src={category.image}
      alt={`Arreglos de la categoría ${category.name}`}
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
      class="aspect-[4/3] w-full object-cover"
    />
  </div>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-display text-xl font-semibold text-burgundy transition-colors duration-200 group-hover:text-red-dark">
      {category.name}
    </h3>
    {/* min-h de 3 líneas reservado siempre: al soltar el recorte en hover, el texto ocupa espacio ya existente y nada se desplaza */}
    <p class="mt-1 line-clamp-2 min-h-[3lh] flex-1 text-sm leading-relaxed text-burgundy/80 group-hover:line-clamp-3 group-focus-visible:line-clamp-3">
      {category.description}
    </p>
    <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-red-dark transition-colors duration-200 group-hover:underline">
      Explorar
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none">
        <path d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </span>
  </div>
</a>
