---
import { categories } from "../lib/catalog";
import BoldPayments from "./BoldPayments.astro";

const year = new Date().getFullYear();
---

<footer class="bg-burgundy text-background">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-5">
    <div>
      <p class="font-display text-2xl font-semibold">Floristería Medellín</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-background/80">
        Arreglos florales frescos con entrega a domicilio en Medellín y el Valle de Aburrá.
      </p>
    </div>

    <nav aria-label="Categorías">
      <h2 class="font-display text-lg font-semibold">Categorías</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          categories.map((c) => (
            <li>
              <a href={`/${c.slug}`} class="inline-flex min-h-11 items-center text-background/80 transition-colors duration-200 hover:text-white">
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Ayuda">
      <h2 class="font-display text-lg font-semibold">Ayuda</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/envios" class="inline-flex min-h-11 items-center text-background/80 transition-colors duration-200 hover:text-white">Zonas y costos de envío</a></li>
        <li><a href="/preguntas-frecuentes" class="inline-flex min-h-11 items-center text-background/80 transition-colors duration-200 hover:text-white">Preguntas frecuentes</a></li>
        <li><a href="/terminos" class="inline-flex min-h-11 items-center text-background/80 transition-colors duration-200 hover:text-white">Términos y condiciones</a></li>
        <li><a href="/privacidad" class="inline-flex min-h-11 items-center text-background/80 transition-colors duration-200 hover:text-white">Política de privacidad</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="font-display text-lg font-semibold">Contacto</h2>
      <ul class="mt-3 space-y-2 text-sm text-background/80">
        <li>Cra. 39 #49-24, segundo piso</li>
        <li>Medellín, Colombia</li>
        <li>Lunes a viernes · 8:00 a. m. – 7:00 p. m.</li>
        <li>Sábados y domingos · 9:00 a. m. – 2:00 p. m.</li>
        <li>
          <a href="https://wa.me/573005267555" class="inline-flex min-h-11 items-center text-background/80 transition-colors duration-200 hover:text-white">
            WhatsApp: +57 300 526 7555
          </a>
        </li>
        <li>
          <a href="mailto:hola@tufloristeria.co" class="inline-flex min-h-11 items-center text-background/80 transition-colors duration-200 hover:text-white">
            hola@tufloristeria.co
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="font-display text-lg font-semibold">Pagos seguros</h2>
      <p class="mt-3 flex items-start gap-2 text-sm leading-relaxed text-background/80">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0">
          <path d="M12 2.5 4 5.5v6c0 5 3.4 8.3 8 10 4.6-1.7 8-5 8-10v-6l-8-3Z" />
          <path d="m8.8 11.8 2.3 2.3 4.2-4.2" />
        </svg>
        <span>
          Procesados por <strong class="font-semibold text-background">Bold</strong>. Nunca almacenamos los datos de tu tarjeta.
        </span>
      </p>
      <div class="mt-4">
        <BoldPayments />
      </div>
    </div>
  </div>

  <div class="border-t border-white/15">
    <p class="mx-auto max-w-7xl px-4 py-4 text-center text-xs text-background/70 sm:px-6">
      © {year} Floristería Medellín 
    </p>
  </div>
</footer>
