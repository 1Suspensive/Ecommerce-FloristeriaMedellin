---
import { categories } from "../lib/catalog";
import AnnouncementBar from "./AnnouncementBar.astro";

const navItems = [
  { href: "/", label: "Inicio" },
  ...categories.map((c) => ({ href: `/${c.slug}`, label: c.name })),
  { href: "/contacto", label: "Contacto" },
];

const currentPath = Astro.url.pathname;
---

<AnnouncementBar />

<header class="sticky top-0 z-40 border-b border-beige/60 bg-background/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-burgundy" aria-label="Floristería Medellín — Inicio">
      <svg width="34" height="34" viewBox="0 0 64 64" aria-hidden="true" class="shrink-0">
        <g transform="translate(32 32)">
          <ellipse cx="0" cy="-14" rx="8" ry="13" fill="#FE5556" />
          <ellipse cx="0" cy="-14" rx="8" ry="13" fill="#FE5556" transform="rotate(72)" />
          <ellipse cx="0" cy="-14" rx="8" ry="13" fill="#FE5556" transform="rotate(144)" />
          <ellipse cx="0" cy="-14" rx="8" ry="13" fill="#FE5556" transform="rotate(216)" />
          <ellipse cx="0" cy="-14" rx="8" ry="13" fill="#FE5556" transform="rotate(288)" />
          <circle r="7.5" fill="#F6A908" />
        </g>
      </svg>
      <span class="font-display text-xl font-semibold leading-none sm:text-2xl">
        Floristería <span class="text-wine">Medellín</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
            class:list={[
              "inline-flex min-h-11 items-center rounded-md px-3 py-2 text-sm font-medium transition-colors duration-200",
              currentPath === item.href
                ? "bg-burgundy text-white"
                : "text-burgundy hover:bg-beige/30",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/carrito"
        class="flex min-h-11 min-w-11 items-center justify-center rounded-md text-burgundy transition-colors duration-200 hover:bg-beige/30"
        aria-label="Ver carrito de compras"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="20" r="1.6" />
          <circle cx="17" cy="20" r="1.6" />
          <path d="M2.5 3.5h2.2l2.4 12a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.2l1.6-8H6" />
        </svg>
      </a>

      <details class="group relative md:hidden">
        <summary
          class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-md text-burgundy transition-colors duration-200 hover:bg-beige/30 [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menú de navegación"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" class="group-open:hidden">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" class="hidden group-open:block">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </summary>
        <nav
          aria-label="Menú móvil"
          class="absolute right-0 top-full mt-2 w-56 rounded-lg border border-beige/60 bg-background p-2 shadow-lg"
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={currentPath === item.href ? "page" : undefined}
                class:list={[
                  "block rounded-md px-4 py-3 text-sm font-medium transition-colors duration-200",
                  currentPath === item.href
                    ? "bg-burgundy text-white"
                    : "text-burgundy hover:bg-beige/30",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
