---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center">
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-widest text-wine">{eyebrow}</p>}
  <h2 class="mt-2 font-display text-3xl font-semibold text-burgundy sm:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-base leading-relaxed text-burgundy/80">{description}</p>}
</div>
