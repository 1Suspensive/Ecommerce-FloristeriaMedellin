---
import type { Testimonial } from "../lib/catalog";

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<figure class="flex h-full flex-col rounded-xl border border-beige/50 bg-white p-6 shadow-sm">
  <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="text-pink">
    <path d="M10 8c-3.3 0-6 2.7-6 6v2h5v-5H6.5A3.5 3.5 0 0 1 10 8Zm10 0c-3.3 0-6 2.7-6 6v2h5v-5h-2.5A3.5 3.5 0 0 1 20 8Z" />
  </svg>
  <blockquote class="mt-4 flex-1">
    <p class="leading-relaxed text-burgundy/90">{testimonial.quote}</p>
  </blockquote>
  <figcaption class="mt-4 border-t border-beige/50 pt-4">
    <p class="font-semibold text-burgundy">{testimonial.name}</p>
    <p class="text-sm text-burgundy/80">{testimonial.detail}</p>
  </figcaption>
</figure>
