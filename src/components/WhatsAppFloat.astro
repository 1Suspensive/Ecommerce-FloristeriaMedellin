---
// Botón flotante de WhatsApp: solo aparece cuando ningún CTA de WhatsApp ([data-wa-cta]) está visible en pantalla.
---

<a
  href="https://wa.me/573005267555"
  id="whatsapp-float"
  aria-label="Escríbenos por WhatsApp"
  aria-hidden="true"
  tabindex="-1"
  class="pointer-events-none fixed bottom-5 right-5 z-50 flex h-14 w-14 translate-y-4 items-center justify-center rounded-full bg-olive text-white opacity-0 shadow-lg transition-[opacity,transform] duration-300 ease-out hover:bg-burgundy motion-reduce:transform-none motion-reduce:transition-none"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.5 14.2c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-2.9-1.3-4.8-4.2-5-4.4-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 1.9 2.4 1.3 1.2 2.4 1.5 2.8 1.7.3.2.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .6-.2 1.3Z" />
  </svg>
</a>

<script>
  const floatBtn = document.getElementById("whatsapp-float");
  const ctas = Array.from(document.querySelectorAll("[data-wa-cta]"));

  if (floatBtn) {
    const hiddenClasses = ["opacity-0", "translate-y-4", "pointer-events-none"];
    const inView = new Set<Element>();

    const update = () => {
      const show = ctas.length === 0 || inView.size === 0;
      hiddenClasses.forEach((c) => floatBtn.classList.toggle(c, !show));
      floatBtn.setAttribute("aria-hidden", String(!show));
      floatBtn.tabIndex = show ? 0 : -1;
    };

    if (ctas.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) inView.add(entry.target);
            else inView.delete(entry.target);
          }
          update();
        },
        { threshold: 0.1 },
      );
      ctas.forEach((el) => observer.observe(el));
    }
    update();
  }
</script>
