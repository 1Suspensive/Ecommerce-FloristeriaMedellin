---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories } from "../lib/catalog";
---

<BaseLayout
  title="Página no encontrada | Floristería en Medellín"
  description="La página que buscas no existe o fue movida. Vuelve al inicio o explora nuestros ramos y flores con entrega a domicilio en Medellín."
  noindex={true}
>
  <main
    id="contenido"
    class="mx-auto flex max-w-2xl flex-col items-center px-4 py-16 text-center sm:px-6 sm:py-24"
  >
    <p class="text-sm font-semibold uppercase tracking-widest text-wine">Error 404</p>

    {/* Numeral decorativo: el "0" es una flor. Va aria-hidden; el significado lo da el h1. */}
    <div
      aria-hidden="true"
      class="mt-8 flex items-center justify-center gap-1 font-display text-8xl font-semibold leading-none text-burgundy sm:text-9xl"
    >
      <span>4</span>
      <svg viewBox="0 0 100 100" class="h-[0.72em] w-[0.72em] shrink-0" focusable="false">
        <ellipse cx="50" cy="29" rx="11" ry="20" fill="#d87990"></ellipse>
        <ellipse cx="50" cy="29" rx="11" ry="20" fill="#fe5556" transform="rotate(60 50 50)"></ellipse>
        <ellipse cx="50" cy="29" rx="11" ry="20" fill="#d87990" transform="rotate(120 50 50)"></ellipse>
        <ellipse cx="50" cy="29" rx="11" ry="20" fill="#fe5556" transform="rotate(180 50 50)"></ellipse>
        <ellipse cx="50" cy="29" rx="11" ry="20" fill="#d87990" transform="rotate(240 50 50)"></ellipse>
        <ellipse cx="50" cy="29" rx="11" ry="20" fill="#fe5556" transform="rotate(300 50 50)"></ellipse>
        <circle cx="50" cy="50" r="12" fill="#f6a908"></circle>
        <circle cx="50" cy="50" r="6" fill="#8b0915"></circle>
      </svg>
      <span>4</span>
    </div>

    <h1 class="mt-8 font-display text-3xl font-semibold text-burgundy sm:text-4xl">
      Esta página se quedó sin flores
    </h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-burgundy/80">
      El enlace puede estar roto o la página pudo moverse. Estas rutas te llevan de vuelta:
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="inline-flex min-h-11 items-center rounded-md bg-red-dark px-6 py-3 text-base font-semibold text-white shadow-sm transition-colors duration-200 hover:bg-wine"
      >
        Volver al inicio
      </a>
      <a
        href="https://wa.me/573005267555"
        data-wa-cta
        class="inline-flex min-h-11 items-center gap-2 rounded-md border-2 border-olive px-6 py-3 text-base font-semibold text-olive transition-colors duration-200 hover:bg-olive hover:text-white"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.5 14.2c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-2.9-1.3-4.8-4.2-5-4.4-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 1.9 2.4 1.3 1.2 2.4 1.5 2.8 1.7.3.2.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .6-.2 1.3Z"
          ></path>
        </svg>
        Ayuda por WhatsApp
      </a>
    </div>

    <nav aria-labelledby="catalogo-404" class="mt-16 w-full max-w-md">
      {/* Separador decorativo: replica en miniatura la flor del "0" del numeral 404 */}
      <div aria-hidden="true" class="flex items-center gap-4">
        <span class="h-px flex-1 bg-beige/70"></span>
        <svg viewBox="0 0 100 100" class="h-6 w-6 shrink-0" focusable="false">
          <ellipse cx="50" cy="29" rx="11" ry="20" fill="#d87990"></ellipse>
          <ellipse cx="50" cy="29" rx="11" ry="20" fill="#fe5556" transform="rotate(60 50 50)"></ellipse>
          <ellipse cx="50" cy="29" rx="11" ry="20" fill="#d87990" transform="rotate(120 50 50)"></ellipse>
          <ellipse cx="50" cy="29" rx="11" ry="20" fill="#fe5556" transform="rotate(180 50 50)"></ellipse>
          <ellipse cx="50" cy="29" rx="11" ry="20" fill="#d87990" transform="rotate(240 50 50)"></ellipse>
          <ellipse cx="50" cy="29" rx="11" ry="20" fill="#fe5556" transform="rotate(300 50 50)"></ellipse>
          <circle cx="50" cy="50" r="12" fill="#f6a908"></circle>
          <circle cx="50" cy="50" r="6" fill="#8b0915"></circle>
        </svg>
        <span class="h-px flex-1 bg-beige/70"></span>
      </div>

      <h2
        id="catalogo-404"
        class="mt-8 text-sm font-semibold uppercase tracking-widest text-burgundy/70"
      >
        O explora el catálogo
      </h2>
      <ul class="mt-6 grid grid-cols-1 gap-3 min-[420px]:grid-cols-2">
        {
          categories.map((category) => (
            <li>
              <a
                href={`/${category.slug}`}
                class="group flex min-h-11 items-center justify-between gap-2 rounded-lg border border-beige/70 bg-white/50 px-4 py-3 text-base font-medium text-burgundy transition-colors duration-200 hover:border-burgundy hover:bg-white"
              >
                {category.name}
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="shrink-0 text-burgundy/50 transition-[transform,color] duration-200 group-hover:text-burgundy motion-safe:group-hover:translate-x-0.5"
                >
                  <path d="M5 12h14" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>
</BaseLayout>
